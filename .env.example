# Optional local secret values. Do not commit .env.
#
# config.yaml should reference these variable names through *_env fields.
# Example:
# models.providers.deepseek.api_key_env: DEEPSEEK_API_KEY

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=
VOLCENGINE_API_KEY=

# Local OpenAI-compatible servers usually do not require a real key, but some
# clients still expect a non-empty value.
OLLAMA_API_KEY=ollama
LMSTUDIO_API_KEY=lmstudio
